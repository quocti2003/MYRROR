# Frontend Environment Variables Template
# Copy this file to .env and update the values as needed

# API Base URL - Backend service endpoint
# For development: http://localhost:8080/api (default backend port)
# For production: https://your-api-domain.com/api
# The backend is running on port 8080 as mentioned in the issue
VITE_API_BASE_URL=http://localhost:8080/api

# Environment mode (automatically set by Vite, but can be overridden)
VITE_NODE_ENV=development

# Optional: Ngrok URL if using tunneling for development
# VITE_BACKEND_NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Google Sheets Script URL for form submission
# Required for submit form functionality
VITE_GOOGLE_SHEETS_SCRIPT_URL=

# Cloudflare Media CDN URL
# Optional: Base URL for media files hosted on Cloudflare
# If not set, media will fallback to public folder
# Example: https://pub-0d0ac1b25b8f4a6ab2a01fcdb1dd59b0.r2.dev (Cloudflare R2)
VITE_CLOUDFLARE_MEDIA_URL=

# PDF Extract API URL (AWS Backend)
# For development: http://localhost:5000
# For production: https://your-aws-backend.com
VITE_PDF_API_URL=http://localhost:5000

# Event Admin Password
# Password for accessing the event admin dashboard at /the-muse-of-love-grown/admin
VITE_EVENT_ADMIN_PASSWORD=