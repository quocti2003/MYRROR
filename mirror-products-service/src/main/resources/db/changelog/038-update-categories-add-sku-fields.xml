<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="038-1" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="categories"/>
                <not>
                    <columnExists tableName="categories" columnName="misa_category_id"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="categories">
            <column name="sku_code" type="VARCHAR(255)"/>
            <column name="misa_category_id" type="VARCHAR(255)"/>
            <column name="misa_category_code" type="VARCHAR(255)"/>
            <column name="misa_category_name" type="VARCHAR(500)"/>
            <column name="misa_last_synced_at" type="TIMESTAMP"/>
        </addColumn>

        <createIndex tableName="categories" indexName="idx_categories_sku_code">
            <column name="sku_code"/>
        </createIndex>

        <createIndex tableName="categories" indexName="idx_categories_misa_category_id">
            <column name="misa_category_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
