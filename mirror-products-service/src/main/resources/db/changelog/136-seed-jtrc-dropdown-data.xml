    <!-- Add Brooch and Cufflinks to existing sku_prefix_options -->
    <changeSet id="136-8" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="sku_prefix_options"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM sku_prefix_options WHERE prefix_code = 'BRH'</sqlCheck>
        </preConditions>

        <insert tableName="sku_prefix_options">
            <column name="prefix_code" value="BRH"/>
            <column name="prefix_name" value="Brooch"/>
            <column name="description" value="Brooch products"/>
            <column name="display_order" valueNumeric="7"/>
        </insert>
        <insert tableName="sku_prefix_options">
            <column name="prefix_code" value="CLK"/>
            <column name="prefix_name" value="Cufflinks"/>
            <column name="description" value="Cufflinks products"/>
            <column name="display_order" valueNumeric="8"/>
        </insert>

        <rollback>
            <delete tableName="sku_prefix_options"><where>prefix_code IN ('BRH', 'CLK')</where></delete>
        </rollback>
    </changeSet>

    <!-- Update EMERALD shape display name to "Emerald Cut" -->
    <changeSet id="136-9" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="stone_shape_options"/>
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM stone_shape_options WHERE shape_code = 'EMERALD'</sqlCheck>
        </preConditions>

        <update tableName="stone_shape_options">
            <column name="shape_name" value="Emerald Cut"/>
            <where>shape_code = 'EMERALD'</where>
        </update>

        <rollback>
            <update tableName="stone_shape_options">
                <column name="shape_name" value="Emerald"/>
                <where>shape_code = 'EMERALD'</where>
            </update>
        </rollback>
    </changeSet>

