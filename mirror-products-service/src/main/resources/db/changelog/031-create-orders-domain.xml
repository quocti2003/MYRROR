<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="029-create-order-sequences" author="system">
        <comment>Create sequences for orders domain identifiers</comment>
        <createSequence sequenceName="order_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="order_item_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="order_payment_schedule_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="order_status_history_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="029-create-orders-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="orders"/>
            </not>
        </preConditions>

        <createTable tableName="orders">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)" remarks="ID of the user placing the order">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="VARCHAR(255)" remarks="Primary product related to the order">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" remarks="Current order status" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="payment_status" type="VARCHAR(50)" remarks="Aggregated payment status" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="payment_terms_type" type="VARCHAR(50)" remarks="Type of payment terms" defaultValue="FIXED_SCHEDULE">
                <constraints nullable="false"/>
            </column>
            <column name="payment_terms" type="TEXT" remarks="Serialized payment terms details"/>
            <column name="payment_outstanding" type="DECIMAL(15,2)" defaultValueNumeric="0.00" remarks="Outstanding amount"></column>
            <column name="subtotal_amount" type="DECIMAL(15,2)" defaultValueNumeric="0.00" remarks="Subtotal before adjustments"></column>
            <column name="total_amount" type="DECIMAL(15,2)" defaultValueNumeric="0.00" remarks="Total amount due">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)" defaultValue="VND">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="expected_delivery_date" type="TIMESTAMP"/>
            <column name="placed_at" type="TIMESTAMP"/>
            <column name="last_status_updated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="orders"
            baseColumnNames="product_id"
            referencedTableName="products"
            referencedColumnNames="id"
            constraintName="fk_orders_product"/>

        <createIndex tableName="orders" indexName="idx_orders_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="orders" indexName="idx_orders_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="orders" indexName="idx_orders_payment_status">
            <column name="payment_status"/>
        </createIndex>
    </changeSet>

    <changeSet id="029-create-order-items-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="order_items"/>
            </not>
        </preConditions>

        <createTable tableName="order_items">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="product_name" type="VARCHAR(500)"/>
            <column name="quantity" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(15,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="DECIMAL(15,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="metadata" type="TEXT"/>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="order_items"
            baseColumnNames="order_id"
            referencedTableName="orders"
            referencedColumnNames="id"
            constraintName="fk_order_items_order"/>

        <addForeignKeyConstraint
            baseTableName="order_items"
            baseColumnNames="product_id"
            referencedTableName="products"
            referencedColumnNames="id"
            constraintName="fk_order_items_product"/>

        <createIndex tableName="order_items" indexName="idx_order_items_order_id">
            <column name="order_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="029-create-order-payment-schedule-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="order_payment_schedule"/>
            </not>
        </preConditions>

        <createTable tableName="order_payment_schedule">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="amount_due" type="DECIMAL(15,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="amount_paid" type="DECIMAL(15,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="paid_at" type="TIMESTAMP"/>
            <column name="payment_method" type="VARCHAR(100)"/>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="order_payment_schedule"
            baseColumnNames="order_id"
            referencedTableName="orders"
            referencedColumnNames="id"
            constraintName="fk_order_payment_schedule_order"/>

        <createIndex tableName="order_payment_schedule" indexName="idx_order_payment_schedule_order">
            <column name="order_id"/>
        </createIndex>
        <createIndex tableName="order_payment_schedule" indexName="idx_order_payment_schedule_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="029-create-order-status-history-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="order_status_history"/>
            </not>
        </preConditions>

        <createTable tableName="order_status_history">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="TEXT"/>
            <column name="changed_by" type="VARCHAR(255)"/>
            <column name="changed_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="order_status_history"
            baseColumnNames="order_id"
            referencedTableName="orders"
            referencedColumnNames="id"
            constraintName="fk_order_status_history_order"/>

        <createIndex tableName="order_status_history" indexName="idx_order_status_history_order">
            <column name="order_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
