<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="043-1" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="skus"/>
                <not>
                    <columnExists tableName="skus" columnName="country_of_origin"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="skus">
            <column name="country_of_origin" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="skus" columnName="country_of_origin"/>
        </rollback>
    </changeSet>

    <changeSet id="043-2" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="mirror_products"/>
                <not>
                    <columnExists tableName="mirror_products" columnName="barcode"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="mirror_products">
            <column name="barcode" type="VARCHAR(100)">
                <constraints nullable="true" unique="true"/>
            </column>
        </addColumn>

        <createIndex tableName="mirror_products" indexName="idx_barcode">
            <column name="barcode"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="mirror_products" indexName="idx_barcode"/>
            <dropColumn tableName="mirror_products" columnName="barcode"/>
        </rollback>
    </changeSet>

    <changeSet id="043-3" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="skus"/>
                <not>
                    <indexExists tableName="skus" indexName="idx_country_origin"/>
                </not>
            </and>
        </preConditions>

        <createIndex tableName="skus" indexName="idx_country_origin">
            <column name="country_of_origin"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="skus" indexName="idx_country_origin"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
