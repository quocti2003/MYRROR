<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ========================================== -->
    <!-- Workflow Engine System                     -->
    <!-- Sprint 3: Workflow Templates & Production Plans -->
    <!-- ========================================== -->

    <!-- Sequences for workflow entities -->
    <changeSet id="119-01-create-workflow-sequences" author="backend-developer">
        <createSequence sequenceName="workflow_template_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="workflow_stage_seq" startValue="1" incrementBy="1"/>
        <createSequence sequenceName="production_plan_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <!-- Workflow Templates Table -->
    <changeSet id="119-02-create-workflow-templates-table" author="backend-developer">
        <createTable tableName="workflow_templates">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category" type="VARCHAR(50)"/>
            <column name="is_default" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>

            <!-- Audit Fields -->
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>

            <!-- Base Entity Fields -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Indexes -->
        <createIndex tableName="workflow_templates" indexName="idx_wft_name">
            <column name="name"/>
        </createIndex>
        <createIndex tableName="workflow_templates" indexName="idx_wft_category">
            <column name="category"/>
        </createIndex>
        <createIndex tableName="workflow_templates" indexName="idx_wft_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="workflow_templates" indexName="idx_wft_is_default">
            <column name="is_default"/>
        </createIndex>
    </changeSet>

    <!-- Workflow Stages Table -->
    <changeSet id="119-03-create-workflow-stages-table" author="backend-developer">
        <createTable tableName="workflow_stages">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="template_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="stage_order" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="required_capability" type="VARCHAR(30)"/>
            <column name="estimated_duration_days" type="INTEGER"/>
            <column name="instructions" type="TEXT"/>
            <column name="is_final_stage" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <!-- Base Entity Fields -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Foreign Key -->
        <addForeignKeyConstraint
            baseTableName="workflow_stages"
            baseColumnNames="template_id"
            constraintName="fk_wfs_template"
            referencedTableName="workflow_templates"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <!-- Unique Constraints -->
        <addUniqueConstraint
            tableName="workflow_stages"
            columnNames="template_id, stage_order"
            constraintName="uk_template_stage_order"/>
        <addUniqueConstraint
            tableName="workflow_stages"
            columnNames="template_id, name"
            constraintName="uk_template_stage_name"/>

        <!-- Indexes -->
        <createIndex tableName="workflow_stages" indexName="idx_wfs_template">
            <column name="template_id"/>
        </createIndex>
        <createIndex tableName="workflow_stages" indexName="idx_wfs_stage_order">
            <column name="stage_order"/>
        </createIndex>
        <createIndex tableName="workflow_stages" indexName="idx_wfs_capability">
            <column name="required_capability"/>
        </createIndex>
    </changeSet>

    <!-- Production Plans Table -->
    <changeSet id="119-04-create-production-plans-table" author="backend-developer">
        <createTable tableName="production_plans">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="collection_plan_id" type="UUID"/>
            <column name="workflow_template_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>

            <!-- Date Fields -->
            <column name="target_start_date" type="DATE"/>
            <column name="target_end_date" type="DATE"/>
            <column name="actual_start_date" type="DATE"/>
            <column name="actual_end_date" type="DATE"/>

            <column name="notes" type="TEXT"/>

            <!-- Audit Fields -->
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>

            <!-- Base Entity Fields -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Foreign Keys -->
        <addForeignKeyConstraint
            baseTableName="production_plans"
            baseColumnNames="workflow_template_id"
            constraintName="fk_ppl_workflow_template"
            referencedTableName="workflow_templates"
            referencedColumnNames="id"
            onDelete="RESTRICT"/>

        <addForeignKeyConstraint
            baseTableName="production_plans"
            baseColumnNames="collection_plan_id"
            constraintName="fk_ppl_collection_plan"
            referencedTableName="collection_plans"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

        <!-- Indexes -->
        <createIndex tableName="production_plans" indexName="idx_ppl_name">
            <column name="name"/>
        </createIndex>
        <createIndex tableName="production_plans" indexName="idx_ppl_collection_plan">
            <column name="collection_plan_id"/>
        </createIndex>
        <createIndex tableName="production_plans" indexName="idx_ppl_workflow_template">
            <column name="workflow_template_id"/>
        </createIndex>
        <createIndex tableName="production_plans" indexName="idx_ppl_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="production_plans" indexName="idx_ppl_target_start">
            <column name="target_start_date"/>
        </createIndex>
        <createIndex tableName="production_plans" indexName="idx_ppl_target_end">
            <column name="target_end_date"/>
        </createIndex>
    </changeSet>

    <!-- Check Constraints -->
    <changeSet id="119-05-add-workflow-check-constraints" author="backend-developer" dbms="postgresql">
        <sql>
            ALTER TABLE workflow_templates
            ADD CONSTRAINT chk_wft_status
            CHECK (status IN ('DRAFT', 'ACTIVE', 'ARCHIVED'));

            ALTER TABLE workflow_stages
            ADD CONSTRAINT chk_wfs_stage_order_positive
            CHECK (stage_order > 0);

            ALTER TABLE workflow_stages
            ADD CONSTRAINT chk_wfs_duration_positive
            CHECK (estimated_duration_days IS NULL OR estimated_duration_days >= 0);

            ALTER TABLE production_plans
            ADD CONSTRAINT chk_ppl_status
            CHECK (status IN ('DRAFT', 'PLANNING', 'APPROVED', 'IN_PRODUCTION', 'COMPLETED', 'CANCELLED'));

            ALTER TABLE production_plans
            ADD CONSTRAINT chk_ppl_dates
            CHECK (target_end_date IS NULL OR target_start_date IS NULL OR target_end_date >= target_start_date);
        </sql>
    </changeSet>

</databaseChangeLog>
