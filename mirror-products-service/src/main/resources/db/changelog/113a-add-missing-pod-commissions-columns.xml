        </preConditions>
        <addColumn tableName="pod_commissions">
            <column name="attributed_amount" type="DECIMAL(15,2)" defaultValueNumeric="0" remarks="Attributed amount">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

