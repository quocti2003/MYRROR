<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add missing columns to pod_commissions table -->

    <changeSet id="113a-add-adjustment-reason" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pod_commissions" columnName="adjustment_reason"/>
            </not>
        </preConditions>
        <addColumn tableName="pod_commissions">
            <column name="adjustment_reason" type="TEXT" remarks="Reason for adjustment"/>
        </addColumn>
    </changeSet>

    <changeSet id="113a-add-adjustments" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pod_commissions" columnName="adjustments"/>
            </not>
        </preConditions>
        <addColumn tableName="pod_commissions">
            <column name="adjustments" type="DECIMAL(15,2)" remarks="Adjustment amount"/>
        </addColumn>
    </changeSet>

    <changeSet id="113a-add-approved-at" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
