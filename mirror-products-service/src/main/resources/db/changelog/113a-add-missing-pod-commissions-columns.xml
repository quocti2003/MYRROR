    <!-- Drop order_id column if it exists (not used by entity) -->
    <changeSet id="113a-drop-order-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="pod_commissions" columnName="order_id"/>
        </preConditions>
        <dropColumn tableName="pod_commissions" columnName="order_id"/>
    </changeSet>

    <!-- Drop order_total column if it exists (not used by entity) -->
    <changeSet id="113a-drop-order-total" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="pod_commissions" columnName="order_total"/>
        </preConditions>
        <dropColumn tableName="pod_commissions" columnName="order_total"/>
