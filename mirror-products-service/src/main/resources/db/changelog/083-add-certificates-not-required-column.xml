<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add certificates_not_required column to mirror_products table -->
    <changeSet id="083-add-certificates-not-required-column" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="mirror_products" columnName="certificates_not_required"/>
            </not>
        </preConditions>

        <addColumn tableName="mirror_products">
            <column name="certificates_not_required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <comment>Add certificates_not_required flag to indicate products that don't need certificates for fulfillment</comment>
    </changeSet>

</databaseChangeLog>
