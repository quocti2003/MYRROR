<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- MISA Inventory Items Table -->
    <changeSet id="036-1" author="claude">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="misa_inventory_items"/>
            </not>
        </preConditions>
        <createTable tableName="misa_inventory_items">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="inventory_item_code" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="inventory_item_name" type="VARCHAR(500)"/>
            <column name="inventory_item_id" type="VARCHAR(255)"/>
            <column name="inventory_item_category_id" type="VARCHAR(255)"/>
            <column name="inventory_item_category_name" type="VARCHAR(255)"/>
            <column name="inventory_item_category_code" type="VARCHAR(255)"/>
            <column name="brand_name" type="VARCHAR(255)"/>
            <column name="unit_name" type="VARCHAR(100)"/>
            <column name="unit_id" type="VARCHAR(255)"/>
            <column name="sale_price" type="DECIMAL(19,2)"/>
            <column name="cost_price" type="DECIMAL(19,2)"/>
            <column name="quantity_on_hand" type="INTEGER"/>
            <column name="quantity_reserved" type="INTEGER"/>
            <column name="quantity_available" type="INTEGER"/>
            <column name="minimum_stock" type="INTEGER"/>
            <column name="maximum_stock" type="INTEGER"/>
            <column name="weight" type="DECIMAL(10,3)"/>
            <column name="dimensions" type="VARCHAR(255)"/>
            <column name="color" type="VARCHAR(100)"/>
            <column name="size" type="VARCHAR(100)"/>
            <column name="material" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_for_sale" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_for_purchase" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="tax_rate" type="DECIMAL(5,2)"/>
            <column name="warranty_period" type="INTEGER"/>
            <column name="warranty_unit" type="VARCHAR(50)"/>
            <column name="origin_country" type="VARCHAR(100)"/>
            <column name="manufacturer" type="VARCHAR(255)"/>
            <column name="barcode" type="VARCHAR(255)"/>
            <column name="image_url" type="VARCHAR(1000)"/>
            <column name="misa_last_modified" type="TIMESTAMP"/>
            <column name="last_sync_date" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="sync_status" type="VARCHAR(50)" defaultValue="PENDING"/>
            <column name="sync_error_message" type="TEXT"/>
        </createTable>
    </changeSet>

    <!-- MISA Product Categories Table -->
    <changeSet id="036-2" author="claude">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="misa_product_categories"/>
            </not>
        </preConditions>
        <createTable tableName="misa_product_categories">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_name" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="category_code" type="VARCHAR(255)"/>
            <column name="parent_id" type="VARCHAR(255)"/>
            <column name="grade" type="INTEGER"/>
            <column name="is_parent" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="is_leaf" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="description" type="TEXT"/>
            <column name="sort_order" type="INTEGER"/>
            <column name="misa_last_modified" type="TIMESTAMP"/>
            <column name="last_sync_date" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- MISA Sync Logs Table -->
    <changeSet id="036-3" author="claude">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="misa_sync_logs"/>
            </not>
        </preConditions>
        <createTable tableName="misa_sync_logs">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sync_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="total_records" type="INTEGER"/>
            <column name="processed_records" type="INTEGER"/>
            <column name="successful_records" type="INTEGER"/>
            <column name="failed_records" type="INTEGER"/>
            <column name="start_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIMESTAMP"/>
            <column name="duration_ms" type="BIGINT"/>
            <column name="error_message" type="TEXT"/>
            <column name="details" type="TEXT"/>
            <column name="triggered_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Indexes for MISA tables -->
    <changeSet id="036-4" author="claude">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="misa_inventory_items"/>
            <tableExists tableName="misa_product_categories"/>
            <tableExists tableName="misa_sync_logs"/>
        </preConditions>

        <createIndex tableName="misa_inventory_items" indexName="idx_misa_items_code">
            <column name="inventory_item_code"/>
        </createIndex>

        <createIndex tableName="misa_inventory_items" indexName="idx_misa_items_category">
            <column name="inventory_item_category_id"/>
        </createIndex>

        <createIndex tableName="misa_inventory_items" indexName="idx_misa_items_brand">
            <column name="brand_name"/>
        </createIndex>

        <createIndex tableName="misa_inventory_items" indexName="idx_misa_items_barcode">
            <column name="barcode"/>
        </createIndex>

        <createIndex tableName="misa_inventory_items" indexName="idx_misa_items_sync_status">
            <column name="sync_status"/>
        </createIndex>

        <createIndex tableName="misa_inventory_items" indexName="idx_misa_items_last_sync">
            <column name="last_sync_date"/>
        </createIndex>

        <createIndex tableName="misa_inventory_items" indexName="idx_misa_items_active">
            <column name="is_active"/>
        </createIndex>

        <createIndex tableName="misa_product_categories" indexName="idx_misa_cat_category_id">
            <column name="category_id"/>
        </createIndex>

        <createIndex tableName="misa_product_categories" indexName="idx_misa_cat_parent_id">
            <column name="parent_id"/>
        </createIndex>

        <createIndex tableName="misa_product_categories" indexName="idx_misa_cat_active">
            <column name="is_active"/>
        </createIndex>

        <createIndex tableName="misa_sync_logs" indexName="idx_misa_sync_type">
            <column name="sync_type"/>
        </createIndex>

        <createIndex tableName="misa_sync_logs" indexName="idx_misa_sync_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="misa_sync_logs" indexName="idx_misa_sync_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Foreign key for category hierarchy -->
    <changeSet id="036-5" author="claude">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="misa_product_categories"/>
        </preConditions>

        <addForeignKeyConstraint
                baseTableName="misa_product_categories"
                baseColumnNames="parent_id"
                constraintName="fk_misa_cat_parent"
                referencedTableName="misa_product_categories"
                referencedColumnNames="category_id"
                onDelete="SET NULL"
                onUpdate="CASCADE"/>
    </changeSet>

</databaseChangeLog>
