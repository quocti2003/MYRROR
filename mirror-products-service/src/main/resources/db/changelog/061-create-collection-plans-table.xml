<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="061-1" author="claude">
        <comment>Create collection_plans table - Seasonal collection planning with targeted demographics</comment>
        <createTable tableName="collection_plans">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="total_quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="deadline" type="DATE"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="total_cost" type="DECIMAL(12,2)"/>
            <column name="estimated_delivery_date" type="DATE"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <rollback>
            <dropTable tableName="collection_plans"/>
        </rollback>
    </changeSet>

    <changeSet id="061-2" author="claude">
        <comment>Create indexes on collection_plans table</comment>
        <createIndex tableName="collection_plans" indexName="idx_collection_plans_name">
            <column name="name"/>
        </createIndex>
        <createIndex tableName="collection_plans" indexName="idx_collection_plans_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="collection_plans" indexName="idx_collection_plans_deadline">
            <column name="deadline"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="collection_plans" indexName="idx_collection_plans_name"/>
            <dropIndex tableName="collection_plans" indexName="idx_collection_plans_status"/>
            <dropIndex tableName="collection_plans" indexName="idx_collection_plans_deadline"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
