<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Expand status column to support new lifecycle values -->
    <changeSet id="047-1" author="claude">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="products"/>
            <columnExists tableName="products" columnName="status"/>
        </preConditions>

        <comment>Expand status column from VARCHAR(20) to VARCHAR(30) for new lifecycle states</comment>

        <modifyDataType tableName="products" columnName="status" newDataType="VARCHAR(30)"/>

        <rollback>
            <modifyDataType tableName="products" columnName="status" newDataType="VARCHAR(20)"/>
        </rollback>
    </changeSet>

    <!-- Migrate existing status values to new lifecycle -->
    <changeSet id="047-1b" author="claude">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="products"/>
            <columnExists tableName="products" columnName="status"/>
        </preConditions>

        <comment>Migrate existing ACTIVE → PUBLISHED, INACTIVE → ARCHIVED</comment>

        <sql>
            UPDATE products SET status = 'PUBLISHED' WHERE status = 'ACTIVE';
            UPDATE products SET status = 'ARCHIVED' WHERE status = 'INACTIVE';
            UPDATE products SET status = 'ARCHIVED' WHERE status = 'DISCONTINUED';
            UPDATE products SET status = 'DRAFT' WHERE status NOT IN ('PUBLISHED', 'ARCHIVED');
        </sql>

        <rollback>
            <sql>
                UPDATE products SET status = 'ACTIVE' WHERE status = 'PUBLISHED';
                UPDATE products SET status = 'INACTIVE' WHERE status = 'ARCHIVED';
            </sql>
        </rollback>
    </changeSet>

    <!-- Add published_at timestamp -->
    <changeSet id="047-2" author="claude">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="products"/>
                <not>
                    <columnExists tableName="products" columnName="published_at"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="products">
            <column name="published_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="products" columnName="published_at"/>
        </rollback>
    </changeSet>

    <!-- Add fulfillment_completed_at timestamp -->
    <changeSet id="047-3" author="claude">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="products"/>
                <not>
                    <columnExists tableName="products" columnName="fulfillment_completed_at"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="products">
            <column name="fulfillment_completed_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="products" columnName="fulfillment_completed_at"/>
        </rollback>
    </changeSet>

    <!-- Update existing products to PUBLISHED status if they have images/description -->
    <changeSet id="047-4" author="claude">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="products"/>
                <columnExists tableName="products" columnName="status"/>
                <columnExists tableName="products" columnName="image_urls"/>
                <columnExists tableName="products" columnName="description"/>
            </and>
        </preConditions>

        <sql>
            UPDATE products
            SET status = 'PUBLISHED',
                published_at = created_at
            WHERE (image_urls IS NOT NULL OR description IS NOT NULL)
              AND status = 'DRAFT';
        </sql>

        <rollback>
            <sql>
                UPDATE products SET status = 'DRAFT' WHERE status = 'PUBLISHED';
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
