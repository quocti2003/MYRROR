<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="004-create-sequences" author="system">
        <comment>Create sequences for ID generation</comment>
        
        <!-- Category sequence -->
        <createSequence sequenceName="category_seq" startValue="1" incrementBy="1"/>
        
        <!-- Component sequence -->
        <createSequence sequenceName="component_seq" startValue="1" incrementBy="1"/>
        
        <!-- ComponentOptional sequence -->
        <createSequence sequenceName="component_optional_seq" startValue="1" incrementBy="1"/>
        
        <!-- ItemVariant sequence -->
        <createSequence sequenceName="item_variant_seq" startValue="1" incrementBy="1"/>
        
        <!-- ItemVariantConfig sequence -->
        <createSequence sequenceName="item_variant_config_seq" startValue="1" incrementBy="1"/>
        
    </changeSet>

</databaseChangeLog>