<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add commission_rate column to pods table -->
    <changeSet id="109b-add-commission-rate-to-pods" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pods" columnName="commission_rate"/>
            </not>
        </preConditions>

        <comment>Add commission_rate column to pods table for POD-specific commission rates</comment>

        <addColumn tableName="pods">
            <column name="commission_rate" type="DECIMAL(5,2)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
