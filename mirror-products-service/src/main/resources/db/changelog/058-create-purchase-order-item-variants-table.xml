<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.11.xsd">

    <changeSet id="058-1" author="claude">
        <comment>Create purchase_order_item_variants table - PO item variants by age group demographics</comment>
        <createTable tableName="purchase_order_item_variants">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="purchase_order_item_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="material_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="age_group_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(10,2)"/>
        </createTable>
    </changeSet>

    <changeSet id="058-2" author="claude">
        <comment>Add foreign key constraints</comment>
        <addForeignKeyConstraint
            constraintName="fk_po_item_variants_po_item"
            baseTableName="purchase_order_item_variants"
            baseColumnNames="purchase_order_item_id"
            referencedTableName="purchase_order_items"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            constraintName="fk_po_item_variants_material"
            baseTableName="purchase_order_item_variants"
            baseColumnNames="material_id"
            referencedTableName="material_inventory"
            referencedColumnNames="id"
            onDelete="RESTRICT"/>

        <addForeignKeyConstraint
            constraintName="fk_po_item_variants_age_group"
            baseTableName="purchase_order_item_variants"
            baseColumnNames="age_group_id"
            referencedTableName="age_groups"
            referencedColumnNames="id"
            onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="058-3" author="claude">
        <comment>Create indexes for purchase_order_item_variants</comment>
        <createIndex tableName="purchase_order_item_variants" indexName="idx_po_item_variants_po_item_id">
            <column name="purchase_order_item_id"/>
        </createIndex>
        <createIndex tableName="purchase_order_item_variants" indexName="idx_po_item_variants_material_id">
            <column name="material_id"/>
        </createIndex>
        <createIndex tableName="purchase_order_item_variants" indexName="idx_po_item_variants_age_group_id">
            <column name="age_group_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
