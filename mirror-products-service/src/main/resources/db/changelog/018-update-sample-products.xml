                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="018-insert-sample-products-fixed" author="system">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM products WHERE id = 'PRD000001'
            </sqlCheck>
        </preConditions>
        
        <comment>Insert sample jewelry products with new ID format</comment>
        
        <insert tableName="products">
            <column name="id" value="PRD000001"/>
            <column name="name" value="Lumina Diamond Ring"/>
            <column name="description" value="Elegant diamond ring featuring a brilliant cut center stone with delicate side accents. Perfect for engagements or special occasions."/>
            <column name="category_id" value="CAT000001"/>
            <column name="sku" value="LUM-DR-001"/>
            <column name="price" value="25000000"/>
            <column name="currency" value="VND"/>
            <column name="metal_type" value="GOLD"/>
            <column name="metal_purity" value="18K"/>
            <column name="stone_type" value="DIAMOND"/>
            <column name="weight_grams" value="3.5"/>
            <column name="dimensions" value='{"width": "6mm", "height": "4mm", "depth": "2mm"}'/>
            <column name="image_url" value="/products/lumina-ring.png"/>
            <column name="image_urls" value='["/products/lumina-ring-1.png", "/products/lumina-ring-2.png", "/products/lumina-ring-3.png"]'/>
            <column name="tags" value='["diamond", "engagement", "luxury", "18k gold"]'/>
            <column name="status" value="ACTIVE"/>
            <column name="featured" value="true"/>
            <column name="stock_quantity" value="15"/>
            <column name="min_stock_level" value="3"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="is_active" value="true"/>
            <column name="is_deleted" value="false"/>
        </insert>
        
