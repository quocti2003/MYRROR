<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="014-create-locations-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="locations"/>
            </not>
        </preConditions>
        
        <comment>Create locations table for store locations management</comment>
        
        <createTable tableName="locations">
            <column name="id" type="VARCHAR(255)" remarks="Primary key">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(500)" remarks="Location name">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(100)" remarks="Location type (SHOWROOM, BOUTIQUE, POD)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="TEXT" remarks="Full address">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)" remarks="City or province">
                <constraints nullable="false"/>
            </column>
            <column name="latitude" type="DECIMAL(10,7)" remarks="GPS latitude">
                <constraints nullable="false"/>
            </column>
            <column name="longitude" type="DECIMAL(10,7)" remarks="GPS longitude">
                <constraints nullable="false"/>
            </column>
            <column name="hours" type="VARCHAR(255)" remarks="Operating hours">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(50)" remarks="Contact phone number">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" remarks="Location status (ACTIVE, INACTIVE, TEMPORARY)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" remarks="Last update timestamp"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Add indexes for common queries -->
        <createIndex tableName="locations" indexName="idx_locations_city">
            <column name="city"/>
        </createIndex>
        
        <createIndex tableName="locations" indexName="idx_locations_type">
            <column name="type"/>
        </createIndex>
        
        <createIndex tableName="locations" indexName="idx_locations_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

