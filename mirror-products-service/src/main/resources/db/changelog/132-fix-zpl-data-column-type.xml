<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Fix zpl_data column type from VARCHAR to TEXT -->
    <changeSet id="124-1" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="print_jobs"/>
        </preConditions>
        <modifyDataType tableName="print_jobs" columnName="zpl_data" newDataType="TEXT"/>
    </changeSet>

    <changeSet id="124-2" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="print_job_items"/>
        </preConditions>
        <modifyDataType tableName="print_job_items" columnName="zpl_data" newDataType="TEXT"/>
    </changeSet>

</databaseChangeLog>
