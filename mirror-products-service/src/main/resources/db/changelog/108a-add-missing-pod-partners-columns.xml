    <!-- Add missing columns to pod_partners table that were skipped due to preconditions -->

    <!-- Drop old email column if both email and contact_email exist -->
    <changeSet id="108a-drop-old-email-column" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="pod_partners" columnName="email"/>
                <columnExists tableName="pod_partners" columnName="contact_email"/>
            </and>
        </preConditions>
        <dropColumn tableName="pod_partners" columnName="email"/>
    </changeSet>

    <!-- Drop old name column if both name and contact_name exist -->
    <changeSet id="108a-drop-old-name-column" author="system">
