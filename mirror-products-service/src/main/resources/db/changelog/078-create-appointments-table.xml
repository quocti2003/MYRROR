<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="078-create-appointments-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="appointments"/>
            </not>
        </preConditions>

        <comment>Create appointments table for customer booking management</comment>

        <createTable tableName="appointments">
            <column name="id" type="VARCHAR(255)" remarks="Primary key (APT prefix)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_title" type="VARCHAR(20)" remarks="Customer title (Mr, Mrs, Ms)"/>
            <column name="customer_first_name" type="VARCHAR(100)" remarks="Customer first name">
                <constraints nullable="false"/>
            </column>
            <column name="customer_last_name" type="VARCHAR(100)" remarks="Customer last name">
                <constraints nullable="false"/>
            </column>
            <column name="customer_email" type="VARCHAR(255)" remarks="Customer email address"/>
            <column name="customer_phone" type="VARCHAR(50)" remarks="Customer phone number">
                <constraints nullable="false"/>
            </column>
            <column name="venue_id" type="VARCHAR(30)" remarks="Reference to locations table">
                <constraints nullable="false"/>
            </column>
            <column name="service" type="VARCHAR(100)" remarks="Type of service requested"/>
            <column name="appointment_date" type="DATE" remarks="Date of appointment">
                <constraints nullable="false"/>
            </column>
            <column name="appointment_time" type="TIME" remarks="Time of appointment">
                <constraints nullable="false"/>
            </column>
            <column name="language" type="VARCHAR(20)" defaultValue="en" remarks="Preferred language"/>
            <column name="preferences" type="TEXT" remarks="Customer preferences and special requests"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING" remarks="Appointment status (PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW)">
                <constraints nullable="false"/>
            </column>
            <column name="cancellation_reason" type="TEXT" remarks="Reason for cancellation if cancelled"/>
            <column name="staff_notes" type="TEXT" remarks="Internal staff notes"/>
            <column name="created_at" type="TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" remarks="Last update timestamp"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false" remarks="Soft delete flag">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true" remarks="Active status flag">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add indexes for common queries -->
        <createIndex tableName="appointments" indexName="idx_appointment_date">
            <column name="appointment_date"/>
        </createIndex>

        <createIndex tableName="appointments" indexName="idx_appointment_venue_date">
            <column name="venue_id"/>
            <column name="appointment_date"/>
        </createIndex>

        <createIndex tableName="appointments" indexName="idx_appointment_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="appointments" indexName="idx_appointment_customer_email">
            <column name="customer_email"/>
        </createIndex>

        <!-- Add foreign key constraint to locations table -->
        <addForeignKeyConstraint
            baseTableName="appointments"
            baseColumnNames="venue_id"
            constraintName="fk_appointment_venue"
            referencedTableName="locations"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            onUpdate="CASCADE"/>
    </changeSet>

</databaseChangeLog>
