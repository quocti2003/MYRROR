<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.11.xsd">

    <changeSet id="053-1" author="claude">
        <comment>Create age_groups table - Customer demographic segments for collection planning</comment>
        <createTable tableName="age_groups">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="min_age" type="INTEGER"/>
            <column name="max_age" type="INTEGER"/>
        </createTable>
    </changeSet>

    <changeSet id="053-2" author="claude">
        <comment>Create indexes for age_groups</comment>
        <createIndex tableName="age_groups" indexName="idx_age_groups_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
