# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Secrets Manager Configuration
USE_SECRETS_MANAGER=true
RDS_SECRET_NAME=rds!db-your-secret-id-here
TEST_RDS_CONNECTION=false

# JWT Configuration - Secrets Manager
JWT_USE_SECRETS_MANAGER=false
JWT_SECRET_NAME=mirror-product-service/jwt-secret
JWT_SECRET_REGION=ap-southeast-1
JWT_SECRET=your_jwt_secret_here_if_not_using_secrets_manager
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# Database Configuration (LOCAL - used when USE_SECRETS_MANAGER=false)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/mirror_product
SPRING_DATASOURCE_USERNAME=mirror_user
SPRING_DATASOURCE_PASSWORD=mirror_password

# RDS Configuration (used with Secrets Manager)
RDS_HOST=mirror-product-db.ch0a2gs8awvf.ap-southeast-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DBNAME=mirror_product

# Security Configuration
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=300

# Rate Limiting
RATE_LIMIT_ENABLED=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000, http://localhost:8080, https://*.ngrok-free.app, https://*.ngrok.io
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true